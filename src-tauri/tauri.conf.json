{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tunnel Helper",
  "version": "0.1.0",
  "identifier": "app.tunnelhelper",
  "build": {
    "frontendDist": "../web"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Tunnel Helper",
        "width": 1120,
        "height": 760,
        "minWidth": 940,
        "minHeight": 620,
        "decorations": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.ico",
      "icons/icon.png"
    ]
  }
}
